# Copy to untracked .env; chmod 600 .env. Never place secrets in YAML.
PREANCHOR_ROOT=/lambda/nfs/preanchor/preanchor
HF_HOME=/lambda/nfs/preanchor/preanchor/cache/huggingface
WANDB_DIR=/lambda/nfs/preanchor/preanchor/wandb
PREANCHOR_ARTIFACTS=/lambda/nfs/preanchor/preanchor/artifacts
WANDB_MODE=offline
HF_TOKEN=
WANDB_API_KEY=
# Set a user-approved second durable destination before stage backup.
PREANCHOR_BACKUP_REMOTE=
# Set only from the user's actual rate and authorised limits.
PREANCHOR_HOURLY_RATE=
PREANCHOR_MAX_RUNTIME_HOURS=
PREANCHOR_MAX_COST=
